# Copy to .env (git-ignored) and fill in. Read by Spring Boot at startup (spring.config.import).
# Same names as the .env of autowini_poster.py, so that file can be copied here as it is.
AUTOWINI_USER=
AUTOWINI_PASS=

# Facebook / Instagram publishing from the admin panel (optional; empty = button disabled).
# See README "Facebook and Instagram".
FB_PAGE_ID=
FB_ACCESS_TOKEN=
IG_USER_ID=
IMGBB_API_KEY=

# Optional: change the admin password of the local site
# APP_ADMIN_PASSWORD=
